# Copiar a .env.local y completar.

# Supabase → Project Settings → API (se exponen al navegador; la seguridad la dan las reglas RLS).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# TMDB → themoviedb.org/settings/api → "API Read Access Token". Solo en el servidor (sin prefijo VITE_).
TMDB_TOKEN=eyJ...
# Opcionales:
# TMDB_LANGUAGE=es-MX
# TMDB_REGION=PE

# Dominio público para la vista previa en WhatsApp. En Vercel se completa solo; ponlo si usas un dominio propio.
# SITE_URL=https://cineclub.vercel.app
